# ==========================================================
# NikitaBot: Autonomous Instagram Reels & Posts AI Agent
# ==========================================================

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# AI & LLM Provider for Multimodal / Transcript Analysis
# (Gemini, OpenAI or local Ollama)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Scraper Settings (Instaloader / yt-dlp)
# Optional: Instagram credentials if scraping private/age-restricted accounts
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
SCRAPE_INTERVAL_MINUTES=15
MAX_REELS_PER_PROFILE=10

# Local Web Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
